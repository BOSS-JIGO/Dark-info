{
  "config_version": 4,
  "enabled": true,
  "app": {
    "name": "Dark-Info",
    "version": "4.0.0",
    "min_supported_app_version": 1,
    "force_update": false,
    "update_url": "",
    "announcement": "",
    "announcement_url": ""
  },
  "website": {
    "url": "https://dark-info.site/demo/index.php",
    "allowed_domains": [
      "dark-info.site"
    ],
    "allow_subdomains": true
  },
  "maintenance": {
    "enabled": false,
    "title": "Maintenance Mode",
    "message": "Service is temporarily unavailable. Please try again later.",
    "retry_button": true
  },
  "branding": {
    "logo_url": "",
    "background_logo_url": ""
  },
  "theme": {
    "mode": "dark",
    "primary": "#7C5CFF",
    "secondary": "#00D4FF",
    "background": "#070811",
    "surface": "#101323",
    "text": "#FFFFFF",
    "muted_text": "#B9BED0",
    "button_text": "#FFFFFF",
    "radius": 22
  },
  "ui": {
    "show_loading": true,
    "show_offline": true,
    "show_retry": true,
    "pull_to_refresh": false,
    "inject_theme_css": false,
    "custom_css": ""
  },
  "buttons": [
    {
      "enabled": false,
      "text": "Open",
      "url": "",
      "external": true
    }
  ],
  "security": {
    "https_only": true,
    "block_unknown_website_domains": true,
    "allow_external_links": false
  },
  "cache": {
    "enabled": true,
    "max_age_hours": 168,
    "use_last_known_good_config": true
  }
}
